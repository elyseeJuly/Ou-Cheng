{
  "name": "ou-cheng-(偶成)",
  "private": true,
  "version": "0.5.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "fetch-data": "node scripts/fetch-poetry.js",
    "build:rhyme": "node scripts/build-rhyme-data.cjs",
    "build:cipai": "node scripts/build-cipai-data.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text-summary",
    "verify:local-only": "node scripts/verify-local-only.cjs",
    "verify:smoke": "node scripts/verify-smoke.cjs && vitest run src/smoke.test.tsx",
    "verify:browser": "playwright test",
    "verify:cloudflare": "node scripts/verify-cloudflare-build.cjs",
    "verify:ios-build": "npm run build:ios && node scripts/verify-ios-build.cjs",
    "verify": "npm run verify:local-only && npm run verify:smoke && npm run verify:browser && npm run typecheck && npm run test:coverage && npm run build && npm run verify:cloudflare",
    "deploy": "npm run verify && wrangler deploy",
    "build:ios": "vite build --mode ios",
    "sync:ios": "npm run verify:ios-build && npx cap sync ios",
    "ios": "npm run sync:ios && npx cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "@google/genai": "^1.34.0",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.562.0",
    "pinyin-pro": "^3.26.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.11.0",
    "three": "^0.183.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.6",
    "happy-dom": "^20.9.0",
    "opencc-js": "^1.0.5",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.6",
    "wrangler": "^4.113.0"
  }
}
